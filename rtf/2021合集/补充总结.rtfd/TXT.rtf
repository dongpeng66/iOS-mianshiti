\f10 \'c8\'e7\'b9\'fb\'b4\'e6\'d4\'da\'d4\'f2\'d4\'f6\'bc\'d3\'b8\'c3\'ca\'fd\'be\'dd\'b5\'c4\'b7\'c3\'ce\'ca\'c6\'b5\'b4\'ce
